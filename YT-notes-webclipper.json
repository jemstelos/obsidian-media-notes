{
	"schemaVersion": "0.1.0",
	"name": "Media Notes",
	"behavior": "create",
	"noteContentFormat": "# {{title}}\n\n## Notes\n\n\n## Description\n\n\n{{content}}",
	"properties": [
		{
			"name": "media_link",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "",
			"type": "date"
		}
	],
	"triggers": [
		"https://www.youtube.com/",
		"https://youtube.com/",
		"https://m.youtube.com/",
		"https://music.youtube.com/",
		"https://youtu.be/",
		"https://www.youtu.be/"
	],
	"noteNameFormat": "{{title}}",
	"path": "YouTube"
}
